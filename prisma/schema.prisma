generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model contacts {
  id         Int       @id @default(autoincrement())
  name       String    @db.VarChar(255)
  email      String    @db.VarChar(255)
  message    String
  created_at DateTime? @default(now()) @db.Timestamp(6)
}

model User {
  id              Int      @id @default(autoincrement())
  username        String?
  email           String   @unique
  password        String
  isEmailVerified Boolean  @default(false)
  signupSource    String?
  createdAt       DateTime @default(now())

  // New fields
  emailVerificationToken String?
  passwordResetToken     String?
  passwordResetExpiry    DateTime?

  workoutSessions WorkoutSession[]
  exercises       Exercise[]

  @@map("users")
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
  NEED_HELP
}

model WorkoutSession {
  id          Int      @id @default(autoincrement())
  userId      Int
  workoutName String?
  createdAt   DateTime @default(now())

  user      User       @relation(fields: [userId], references: [id])
  exercises Exercise[]

  @@index([userId, createdAt])
  @@map("workout_sessions")
}

model Exercise {
  id               Int @id @default(autoincrement())
  userId           Int
  workoutSessionId Int

  muscleGroup  String
  exerciseName String
  equipment    Equipment @default(BARBELL)
  createdAt    DateTime  @default(now())

  user           User           @relation(fields: [userId], references: [id])
  workoutSession WorkoutSession @relation(fields: [workoutSessionId], references: [id], onDelete: Cascade)

  sets ExerciseSet[]

  @@index([userId])
  @@index([workoutSessionId])
  @@map("exercises")
}

model ExerciseSet {
  id         Int @id @default(autoincrement())
  exerciseId Int

  setNumber Int
  weight    Float
  reps      Int

  difficulty Difficulty
  createdAt  DateTime   @default(now())

  exercise Exercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)

  @@index([exerciseId])
  @@map("exercise_sets")
}

enum Equipment {
  BARBELL
  DUMBBELL
  SMITH_MACHINE
  MACHINE
  EZ_BAR
  CABLE
  BODYWEIGHT
  RESISTANCE_BAND
  KETTLEBELL
  OTHER
}

// ADD THESE TWO MODELS TO YOUR EXISTING schema.prisma

model WebhookBin {
  id        String           @id @default(uuid())
  slug      String           @unique // e.g. "xw_a1b2c3d4"
  createdAt DateTime         @default(now())
  expiresAt DateTime // set to now() + 48h in the controller
  requests  WebhookRequest[]

  @@index([slug])
  @@index([expiresAt])
  @@map("webhook_bins")
}

model WebhookRequest {
  id         Int      @id @default(autoincrement())
  binId      String
  method     String   @db.VarChar(10)
  headers    Json
  query      Json
  body       Json?
  rawBody    String?
  ip         String?  @db.VarChar(100)
  receivedAt DateTime @default(now())

  bin WebhookBin @relation(fields: [binId], references: [id], onDelete: Cascade)

  @@index([binId, receivedAt])
  @@map("webhook_requests")
}
